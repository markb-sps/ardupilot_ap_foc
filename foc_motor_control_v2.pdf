\);               \r\n    var qTop = Math.min\(Math.min\(quads[1], quads[3]\), Math.min\(quads[5], quads[7]\\)\);                 \r\n    var qBottom = Math.max\(Math.max\(quads[1], quads[3]\), Math.max\(quads[5], quads[7]\)\);              \r\n    if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj256 0 obj<</JS(function ShowCompProps_8805A81E1A544B9AA4EE761CEBCFB580\(\){var sChoice = app.popUpMenu\("Case Code \(Imperial\): 1210","Case Code \(Metric\): 3225","Case/Package: 1210","Comment: C1210 10uF 100V X7S","Component Kind: Standard","Depth: 2.5mm","Description\: Ceramic Capacitor, Ceramic, 100V, 20% +Tol, 20% -Tol, X7S, 22% TC, 10uF, Surface Mount, 1210","Dielectric: X7S","Footprint: CAPC3225X270X30LL30","Height: 2.5mm","Ibis Model: ","Lead Free: Lead Free","Length: 3.2mm","Library Name: SPS Automation","Librar\y Reference: CMP-001-00158-3","Material: Ceramic","Max Operating Temperature: 125\\u00B0C","Min Operating Temperature: -55\\u00B0C","Mounting Technology: Surface Mount","Package Quantity: 1","Packaging: Tape and Reel","PCB3D: ","Pin Info: ","Pins: 2","Rea\ch SVHC Compliant: No","RoHS Compliant: Yes","Series: GRM","Signal Integ